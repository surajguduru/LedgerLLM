# Copy to .env for local dev. Every value has a safe default; nothing here is required for `make dev`.
APP_ENV=dev
LOG_LEVEL=INFO

# sqlite for zero-setup local dev; docker-compose and prod use Postgres:
DATABASE_URL=sqlite:///./ledgerllm.db
# DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:5432/ledger

# mock = free, deterministic, offline (default).
# gemini = real model on Google's permanent free tier. Get a key (no card) at https://aistudio.google.com/apikey
# Other presets: groq | openai | openrouter | ollama | openai_compat (set LLM_BASE_URL) | anthropic
LLM_PROVIDER=mock
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIza...
DEFAULT_MODEL=gemini-3.8-flash
# Hidden reasoning tokens come out of the same max_tokens budget as the summary. Unset = preset default
# (gemini: low, the lowest level both gemini-3.8-flash and gemini-3.5-flash-lite accept); empty = don't send.
# LLM_REASONING_EFFORT=low
# Fallback chain: on 429 / 5xx / timeout, retry once on this provider + model and bill the model that answered.
# Off unless LLM_FALLBACK_PROVIDER is set. Gemini quotas are per model, so a second Gemini model on the same key works.
# LLM_FALLBACK_PROVIDER=gemini
# LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_API_KEY=          # empty: reuse LLM_API_KEY when the fallback provider is the same
# LLM_FALLBACK_BASE_URL=         # only to override the preset
# LLM_FALLBACK_TIMEOUT_S=        # empty: LLM_TIMEOUT_S

# Token for /admin/* endpoints (creating tenants and keys)
ADMIN_TOKEN=dev-admin-token-change-me

# enforce | shadow | off   (shadow = log what WOULD be blocked, don't block)
GUARDRAILS_MODE=enforce
# Second detection layer: an LLM classifier for heuristically uncertain inputs. on | off.
# Costs ~1 Flash-Lite call per uncertain request, billed to the tenant. Needs a real LLM_PROVIDER.
GUARDRAIL_LLM=off
GUARDRAIL_LLM_MODEL=gemini-3.5-flash-lite
RESPONSE_CACHE_ENABLED=true
